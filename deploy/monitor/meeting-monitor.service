[Unit]
Description=Meeting resource monitor (metrics to JSONL)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
# 读取部署 .env（LOG_RETENTION_DAYS 等可生效）；前导 - 表示文件缺失不报错
EnvironmentFile=-@WORKDIR@/.env
ExecStart=/usr/bin/env bash /usr/local/lib/meeting/meeting-monitor.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
