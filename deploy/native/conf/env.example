# ============================================================
# ⚠️ 适用场景：RPM / DEB / 离线发布包（主机部署，无容器）
# 该模板随安装包部署到目标机 /opt/meeting/conf/env.example。
# 其他场景请勿使用：
#   · 本地开发调试                        → .env.example
#   · Docker Compose 在线 / 离线镜像部署   → .env.production.example
# Meet configuration — copy to conf/.env and edit.
# Works for both native (tar.gz) and RPM/DEB deployments.
# Run: node bin/configure.mjs for interactive setup.
# ============================================================

# ──────────────────────────────────────
# Database (default: SQLite = zero-dependency)
# ──────────────────────────────────────
DB_DRIVER=sqlite
SQLITE_PATH=/opt/meeting/data/meeting.sqlite

# To use MySQL instead:
# DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=meeting
# MYSQL_PASSWORD=meetingpass
# MYSQL_DATABASE=meeting

# To use PostgreSQL instead:
# DB_DRIVER=postgres
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=meeting
# PGPASSWORD=meetingpass
# PGDATABASE=meeting

# ──────────────────────────────────────
# Redis (default: memory = zero-dependency, single-node only)
# ──────────────────────────────────────
# Use "memory" for single-node deployments (no external Redis needed).
# Set to actual host for multi-node or if Redis is available.
REDIS_HOST=memory
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ──────────────────────────────────────
# Service Ports
# ──────────────────────────────────────
# 仅 API/WS 为内部端口，不对外发布。
API_PORT=8080
WS_PORT=8082
# 对外统一入口：默认 443（HTTPS）。需在 CERT_DIR 放置证书，否则 443 为明文 HTTP。
GATEWAY_PORT=443

# ──────────────────────────────────────
# WebRTC (must configure for LAN/WAN access)
# ──────────────────────────────────────
# Browser-reachable IP/hostname for WebRTC ICE (REQUIRED)
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_LISTEN_IP=0.0.0.0
RTC_MIN_PORT=40000
RTC_MAX_PORT=41000

# ──────────────────────────────────────
# Recording storage
# ──────────────────────────────────────
# RECORDINGS_DIR=/opt/meeting/data/recordings

# ──────────────────────────────────────
# Meeting behavior
# ──────────────────────────────────────
# 房间空置（最后一人离开）超过该毫秒数后自动把会议置为"已结束"，
# 避免会议长期停留在"进行中"（首页列表/后台在线会议/站内待加入提醒出现幽灵数据）。
# 0 表示关闭该行为。注意：一旦自动结束，原会议链接/会议号将无法再加入。
MEETING_EMPTY_ROOM_GRACE_MS=180000
# 主持人离开后的重连窗口（毫秒）：断网/崩溃/关页面、以及误点浏览器返回/路由跳走，
# 都算"可重连的离开"——窗口内主持人重新进入则会议继续，超时未归才自动结束会议。
# 0 表示关闭该行为。真正散会请让主持人点「结束会议」（立即结束，不走这个窗口）。
# 主持人从未入会的会议不适用（避免早到的参会者被误结束）。
MEETING_HOST_RECONNECT_GRACE_MS=300000
# 兜底扫描周期：清理"服务重启后遗留的 live 会议"（房间是内存态，重启后定时器丢失）。
# 0 表示关闭。仅在 realtime 单实例部署下安全。
MEETING_STALE_SWEEP_MS=60000

# 前后端共用的密码传输加密密钥（必须与前端构建时一致）
# MEETING_CRYPTO_KEY=<请替换为随机字符串>

# ──────────────────────────────────────
# TLS 证书（默认 443 即 HTTPS，必须提供）
# ──────────────────────────────────────
# 网关自动检测本目录下的 fullchain.pem + privkey.pem；缺失时 443 为明文 HTTP。
# 生成（信创推荐 CA 模式，额外产出 ca.crt 供客户端导入）：
#   sudo /opt/meeting/bin/genssl.sh <server-ip>
#   sudo /opt/meeting/bin/node /opt/meeting/bin/gen-cert.mjs --ca <server-ip>
# 默认目录为安装前缀下的 certs/（勿写死，便于自定义 MEETING_PREFIX）。
# CERT_DIR=/opt/meeting/certs