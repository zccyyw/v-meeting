[Unit]
Description=Meeting API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meeting
Group=meeting
WorkingDirectory=/opt/meeting/app/serve/api
EnvironmentFile=-/opt/meeting/conf/.env

# Auto-migrate database before start (node direct, no shell)
ExecStartPre=/opt/meeting/runtime/bin/node dist/migrate.js
# Seed default admin (idempotent)
ExecStartPost=/opt/meeting/runtime/bin/node dist/seed-admin.js

# systemd 219 (Kylin V10 SP1) does not support StandardOutput=append:;
# redirect inside the command instead. `exec` keeps PID/signals on node.
ExecStart=/bin/sh -c "exec /opt/meeting/runtime/bin/node dist/index.js >> /opt/meeting/logs/api.log 2>&1"
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
