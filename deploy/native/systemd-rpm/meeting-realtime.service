[Unit]
Description=Meeting Realtime (signaling + mediasoup)
After=network-online.target meeting-api.service
Wants=network-online.target

[Service]
Type=simple
User=meeting
Group=meeting
WorkingDirectory=/opt/meeting/app/serve/realtime
EnvironmentFile=-/opt/meeting/conf/.env
ExecStart=/opt/meeting/runtime/bin/node dist/index.js
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=append:/opt/meeting/logs/realtime.log
StandardError=append:/opt/meeting/logs/realtime.err.log

[Install]
WantedBy=multi-user.target
