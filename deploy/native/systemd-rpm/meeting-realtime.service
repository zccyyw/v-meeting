[Unit]
Description=Meeting Realtime (signaling + mediasoup)
After=network-online.target meeting-api.service
Wants=network-online.target

[Service]
Type=simple
User=meeting
Group=meeting
WorkingDirectory=/opt/meeting/app/serve/realtime
EnvironmentFile=-/opt/meeting/conf/.env
# systemd 219 (Kylin V10 SP1) does not support StandardOutput=append:;
# redirect inside the command instead. `exec` keeps PID/signals on node.
ExecStart=/bin/sh -c "exec /opt/meeting/runtime/bin/node dist/index.js >> /opt/meeting/logs/realtime.log 2>&1"
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
