[Unit]
Description=Meeting HTTP Gateway (static + /api + /ws)
After=network-online.target meeting-api.service meeting-realtime.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PREFIX@
EnvironmentFile=-@PREFIX@/conf/.env
Environment=FRONT_ROOT=@PREFIX@/app/front
Environment=API_UPSTREAM=http://127.0.0.1:8080
Environment=WS_UPSTREAM=http://127.0.0.1:8082
# systemd 219 (Kylin V10 SP1) does not support StandardOutput=append:;
# redirect inside the command instead. `exec` keeps PID/signals on node.
ExecStart=/bin/sh -c "exec @NODE@ @PREFIX@/bin/gateway.mjs >> @PREFIX@/logs/gateway.log 2>&1"
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
