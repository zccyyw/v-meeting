[Unit]
Description=Meeting Realtime (signaling + mediasoup)
After=network-online.target meeting-api.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PREFIX@/app/serve/realtime
EnvironmentFile=-@PREFIX@/conf/.env
ExecStart=@NODE@ dist/index.js
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
# mediasoup / WebRTC
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=append:@PREFIX@/logs/realtime.log
StandardError=append:@PREFIX@/logs/realtime.err.log

[Install]
WantedBy=multi-user.target
