[Unit]
Description=Meeting Realtime (signaling + mediasoup)
After=network-online.target meeting-api.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PREFIX@/app/serve/realtime
EnvironmentFile=-@PREFIX@/conf/.env
# systemd 219 (Kylin V10 SP1) does not support StandardOutput=append:;
# redirect inside the command instead. `exec` keeps PID/signals on node.
ExecStart=/bin/sh -c "exec @NODE@ dist/index.js >> @PREFIX@/logs/realtime.log 2>&1"
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
# mediasoup / WebRTC
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
