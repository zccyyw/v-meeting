[Unit]
Description=Meeting API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PREFIX@/app/serve/api
EnvironmentFile=-@PREFIX@/conf/.env
ExecStart=@NODE@ dist/index.js
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
StandardOutput=append:@PREFIX@/logs/api.log
StandardError=append:@PREFIX@/logs/api.err.log

[Install]
WantedBy=multi-user.target
