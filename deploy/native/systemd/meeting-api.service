[Unit]
Description=Meeting API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@PREFIX@/app/serve/api
EnvironmentFile=-@PREFIX@/conf/.env
# systemd 219 (Kylin V10 SP1) does not support StandardOutput=append:;
# redirect inside the command instead. `exec` keeps PID/signals on node.
ExecStart=/bin/sh -c "exec @NODE@ dist/index.js >> @PREFIX@/logs/api.log 2>&1"
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
