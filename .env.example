# ============================================================
# ⚠️ 适用场景：本地开发调试（无 Docker，npm run dev）
# 请勿用于生产部署。生产请改用以下对应模板：
#   · Docker Compose 在线部署 / Docker 离线镜像部署 → .env.production.example
#   · RPM / DEB / 离线发布包（主机部署）          → deploy/native/conf/env.example
# 关键差异：本文件的 VITE_API_BASE / VITE_WS_URL 为本地直连值，
# 生产环境取值不同（/api、auto），混用会导致前端请求不到 API。
# Copy to `.env` in the repo root if you want; services also read process env.
# Docs: docs/项目打包与部署说明.md
# ============================================================

# Database driver: sqlite（默认，零依赖）| mysql | postgres
# SQLite（零依赖，无需额外服务）
# SQLITE_PATH=./data/meeting.sqlite

DB_DRIVER=mysql

# MySQL 8 (used when DB_DRIVER=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Root@9527
MYSQL_DATABASE=meeting

# PostgreSQL 12+ (used when DB_DRIVER=postgres)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=meeting

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 生产/共享 Redis 建议设置密码；本机无密码环境可留空
REDIS_PASSWORD=Redis@9527

API_PORT=8080
FRONT_PORT=8081
WS_PORT=8082

# Browser-reachable IP for WebRTC ICE. Use 127.0.0.1 for same-machine only.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_LISTEN_IP=0.0.0.0
RTC_MIN_PORT=40000
RTC_MAX_PORT=41000

# Vite (front) — must match API_PORT / WS_PORT
VITE_API_BASE=http://127.0.0.1:8080
VITE_WS_URL=ws://127.0.0.1:8082

# 录制文件存储目录
# RECORDINGS_DIR=./data/recordings

# 前后端共用的密码传输加密密钥（必须与后端一致，勿用默认值）
# MEETING_CRYPTO_KEY=<请替换为随机字符串>

# App branding (built into front static assets; rebuild front to apply)
VITE_APP_NAME=Meeting
VITE_APP_LOGO=/favicon.svg