{
  "name": "@meeting/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node --env-file=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed-admin.ts",
    "db:reset": "tsx --env-file=../../.env src/reset-db.ts",
    "test": "tsx --env-file=../../.env ../../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.0",
    "@meeting/db": "0.0.1",
    "@meeting/shared": "0.0.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
