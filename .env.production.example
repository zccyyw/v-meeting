# ============================================================
# ⚠️ 适用场景：Docker Compose 在线部署 / Docker 离线镜像部署
# 该文件会被 pack:docker 复制为离线包内的 env.example（离线部署用同一模板）。
# 其他场景请勿使用：
#   · 本地开发调试                    → .env.example
#   · RPM / DEB / 离线发布包（主机部署）→ deploy/native/conf/env.example
# 直接 docker-compose up -d 启动，无需 -f / --profile / --env-file 参数
# Docs: docs/install/本地部署说明-docker.md · docs/变更日志.md
# ============================================================

# Database profile & driver: sqlite（默认，零依赖）| postgres | mysql
# 只需改这一项，DB_DRIVER 会自动跟随
# sqlite：无独立数据库容器，数据存于 meeting-data volume 的 /app/data/meeting.sqlite
# postgres / mysql：启动对应数据库容器
COMPOSE_PROFILES=sqlite

# SQLite 文件路径（默认 /app/data/meeting.sqlite，Docker 内挂载点）
# SQLITE_PATH=/app/data/meeting.sqlite

# 录制文件存储目录（默认 /app/data/recordings，位于 meeting-data volume 内）
# RECORDINGS_DIR=/app/data/recordings

# 会议自动结束：房间空置（最后一人离开）超过该毫秒数后自动把会议置为"已结束"，
# 避免会议长期停留在"进行中"（首页列表/后台在线会议/站内待加入提醒出现幽灵数据）。
# 0 表示关闭该行为。注意：一旦自动结束，原会议链接/会议号将无法再加入。
MEETING_EMPTY_ROOM_GRACE_MS=180000
# 主持人离开后的重连窗口（毫秒）：断网/崩溃/关页面、以及误点浏览器返回/路由跳走，
# 都算"可重连的离开"——窗口内主持人重新进入则会议继续，超时未归才自动结束会议。
# 0 表示关闭该行为。真正散会请让主持人点「结束会议」（立即结束，不走这个窗口）。
# 主持人从未入会的会议不适用（避免早到的参会者被误结束）。
MEETING_HOST_RECONNECT_GRACE_MS=300000
# 兜底扫描周期：清理"服务重启后遗留的 live 会议"（房间是内存态，重启后定时器丢失）。
# 0 表示关闭。仅在 realtime 单实例部署下安全。
MEETING_STALE_SWEEP_MS=60000

# Redis 登录会话存储：容器只在内网监听，务必设置强密码并保持一致
REDIS_PASSWORD=change-me-redis

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=meeting
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=meeting

# When using Postgres profile:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting

# 前后端共用的密码传输加密密钥（必须与前端构建时一致；未设置则使用内置默认密钥）
# 生成：openssl rand -base64 32
MEETING_CRYPTO_KEY=change-me-crypto-key

# Public IP or DNS (WebRTC announce; also used when generating self-signed certs)
MEDIASOUP_ANNOUNCED_IP=10.0.0.10
MEDIASOUP_LISTEN_IP=0.0.0.0

# WebRTC 媒体 UDP 端口段（默认 40000-41000）。如需修改，改这里即可：
# 容器环境变量与宿主机端口映射（docker-compose.yml）都会跟随。
RTC_MIN_PORT=40000
RTC_MAX_PORT=41000
# Before first up: bash deploy/docker/gen-selfsigned.sh <same-as-MEDIASOUP_ANNOUNCED_IP>

# Built into the web image (Caddy path-based proxy)
VITE_API_BASE=/api
# Prefer auto (same-origin wss) or set explicit: wss://meeting.example.com/ws
VITE_WS_URL=auto

# App branding (built into the web image; rebuild to apply)
VITE_APP_NAME=Meeting
VITE_APP_LOGO=/favicon.svg