{
  "name": "meeting",
  "private": true,
  "workspaces": [
    "front",
    "serve/*",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build -w @meeting/shared && npm run build -w @meeting/db",
    "pack": "node ./scripts/pack.mjs",
    "pack:docker": "node ./scripts/pack-docker.mjs",
    "pack:native": "node ./scripts/pack-native.mjs",
    "pack:rpm": "node ./scripts/pack-rpm.mjs",
    "gen:docs": "node ./scripts/gen-install-docs.mjs",
    "test": "npm run test -ws --if-present",
    "migrate": "npm run migrate -w @meeting/api",
    "seed": "npm run seed -w @meeting/api",
    "db:reset": "npm run db:reset -w @meeting/api",
    "dev:api": "npm run dev -w @meeting/api",
    "dev:realtime": "npm run dev -w @meeting/realtime",
    "dev:front": "npm run dev -w @meeting/front",
    "dev": "concurrently -k -n api,realtime,front -c blue,magenta,green \"npm run dev:api\" \"npm run dev:realtime\" \"npm run dev:front\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "node-forge": "^1.3.1"
  }
}
