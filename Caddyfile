# File-based TLS. Generate certs first:
#   bash deploy/docker/gen-selfsigned.sh <public-ip-or-dns>
#
# IMPORTANT: use https:// (not bare :443) so Caddy actually terminates TLS.
# With `auto_https off` + `:443`, port 443 may speak plain HTTP → curl TLS alert.

https:// {
	tls /certs/fullchain.pem /certs/privkey.pem

	# 访问日志落盘到挂载目录（compose 挂载 ./logs/caddy:/var/log/caddy）；
	# 关闭 caddy 内建滚动（roll），由宿主机 logrotate copytruncate 统一轮转
	log {
		output file /var/log/caddy/caddy.log {
			roll_disabled
		}
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8080
	}
	handle /ws {
		reverse_proxy realtime:8082
	}
	handle {
		reverse_proxy web:80
	}
}

http:// {
	redir https://{host}{uri} permanent
}
